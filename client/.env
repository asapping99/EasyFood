HOST=0.0.0.0
PORT=3000

# API URL 설정
REACT_APP_API_URL=http://hobbygom.ddns.net:8085/api
# REACT_APP_API_URL=http://localhost:8085/api

# 이미지 서버 URL (API URL과 동일하지만 /api 제외)
